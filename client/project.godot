; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="星夢Online：拾光"
run/main_scene="uid://dr6itpwa7vume"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://wylawdfsm2mb"
config/macos_native_icon="res://icon.icns"
config/windows_native_icon="res://icon.ico"

[autoload]

CursorManager="*uid://bhg35m53hsmad"
AudioManager="*uid://c1rqchy6sfpq1"
AnimationTimingManager="*res://scripts/animation_timing_manager.gd"
NetworkManager="*uid://da08h4i32i3kn"
NetworkEntityManager="*uid://d032et4jce1bn"
GameManager="*uid://11pyra8dxdfy"
BuildingManager="*uid://bsm5xlo5jd2jp"
DollLoader="*uid://d0d5shkjel7jf"
ItemLoader="*uid://4not4pcr8nm2"
DropItemManager="*uid://b5ll7baet7lb2"
MonsterLoader="*uid://bdek7w4o6d34r"
EffectLoader="*uid://bogvnbqw7my78"
GlobalTempData="*uid://c6et2486ax5md"
FloatingTextManager="*uid://o4mwdccqvhu1"
SkillLoader="*uid://bomelrk1s4yvv"
PetLoader="*uid://4pxea1c72jfd"
QuestLoader="*uid://cv200unw74r1k"
LegacyPathfinder="*res://scripts/legacy_pathfinder.gd"

[display]

window/size/viewport_width=1400
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="client"

[editor]

export/convert_text_resources_to_binary=false

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[layer_names]

2d_physics/layer_1="World_Obstacles"
2d_physics/layer_2="Player"
2d_physics/layer_3="House_Detection"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
