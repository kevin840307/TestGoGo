[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/skill_card.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card"]
bg_color = Color(0.0784314, 0.164706, 0.278431, 0.82)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.298039, 0.933333, 0.898039, 0.22)
corner_radius_top_left = 7
corner_radius_top_right = 7
corner_radius_bottom_right = 7
corner_radius_bottom_left = 7

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_card_hover"]
bg_color = Color(0.105882, 0.223529, 0.356863, 0.94)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.298039, 0.933333, 0.898039, 0.7)
corner_radius_top_left = 7
corner_radius_top_right = 7
corner_radius_bottom_right = 7
corner_radius_bottom_left = 7

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_badge"]
bg_color = Color(0.117647, 0.270588, 0.4, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.298039, 0.933333, 0.898039, 0.42)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 7.0
content_margin_right = 7.0
content_margin_top = 2.0
content_margin_bottom = 2.0

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_focus"]

[node name="SkillCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 60)
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card")
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 8

[node name="Content" type="HBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="IconCenter" type="CenterContainer" parent="Margin/Content"]
custom_minimum_size = Vector2(44, 44)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2

[node name="Icon" type="TextureRect" parent="Margin/Content/IconCenter"]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="NameRow" type="VBoxContainer" parent="Margin/Content"]
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
theme_override_constants/separation = 2

[node name="Name" type="Label" parent="Margin/Content/NameRow"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.941176, 0.176471, 1)
theme_override_font_sizes/font_size = 15
text = "技能名稱"
horizontal_alignment = 1
text_overrun_behavior = 3
vertical_alignment = 1

[node name="Level" type="Label" parent="Margin/Content/NameRow"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.741176, 0.803922, 0.890196, 1)
theme_override_font_sizes/font_size = 12
text = "Lv.1 / 5"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Type" type="Label" parent="Margin/Content"]
custom_minimum_size = Vector2(100, 0)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_colors/font_color = Color(0.654902, 1, 0.964706, 1)
theme_override_font_sizes/font_size = 14
theme_override_styles/normal = SubResource("StyleBoxFlat_badge")
text = "技能類型"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Summary" type="Label" parent="Margin/Content"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_override_colors/font_color = Color(0.741176, 0.803922, 0.890196, 1)
theme_override_font_sizes/font_size = 14
text = "MP 10　｜　冷卻 5秒"
vertical_alignment = 1
text_overrun_behavior = 3

[connection signal="mouse_entered" from="." to="." method="add_theme_stylebox_override" binds=["panel", SubResource("StyleBoxFlat_card_hover")]]
[connection signal="mouse_exited" from="." to="." method="add_theme_stylebox_override" binds=["panel", SubResource("StyleBoxFlat_card")]]
